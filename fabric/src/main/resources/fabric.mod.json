{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Improves Slimes with new configurable features.",
  "authors": [
    "Lunade/AViewFromTheTop"
  ],
  "contact": {
    "homepage": "${mod_url}",
    "sources": "${source_url}",
    "issues": "${issues_url}"
  },
  "license": "${mod_license}",
  "icon": "assets/lunaslimes/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.lunade.slime.LunaSlimesFabric"
    ],
    "client": [
      "net.lunade.slime.LunadeSlimesFabricClient"
    ],
    "modmenu": [
      "net.lunade.slime.config.gui.LunaSlimesModMenuIntegration"
    ]
  },
  "mixins": [
    "lunaslimes.mixins.json"
  ],
  "accessWidener": "lunaslimes.classtweaker",
  "depends": {
    "frozenlib": "${frozenlib_version}",
    "fabricloader": "${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=25"
  },
  "suggests": {
    "cloth-config": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "X": "https://x.com/FB_Oasis",
        "Bluesky": "https://bsky.app/profile/frozenblock.bsky.social",
        "modmenu.discord": "https://discord.gg/frozenblock",
        "modmenu.modrinth": "https://modrinth.com/organization/frozenblock",
        "modmenu.youtube": "https://www.youtube.com/@frozenblockmoddingoasismod",
        "modmenu.kofi": "https://ko-fi.com/frozenblock"
      },
      "badges": [
        "frozenblock"
      ]
    }
  }
}
