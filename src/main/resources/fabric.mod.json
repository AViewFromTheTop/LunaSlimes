{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "Luna Slimes",
  "description": "Improves Slimes and makes them configurable.",
  "authors": [
    "Luna"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/luna-slimes",
    "sources": "https://github.com/AViewFromTheTop/LunaSlimes",
    "issues": "https://github.com/AViewFromTheTop/LunaSlimes/issues"
  },
  "license": "MIT",
  "icon": "assets/lunaslimes/textures/lunaslimes.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.lunade.slime.LunaSlimesMain"
    ],
    "client": [
      "net.lunade.slime.LunaSlimesClient"
    ],
    "modmenu": [
      "net.lunade.slime.LunaSlimesModMenu"
    ]
  },
  "mixins": [
    "lunaslimes.mixins.json"
  ],
  "accessWidener": "lunaslimes.accesswidener",
  "depends": {
    "fabric-api": "${fabric_api_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  },
  "suggests": {
    "cloth-config": "*",
    "frozenlib": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/frozenblock-modding-oasis-780746010614956112",
        "modmenu.modrinth": "https://modrinth.com/mod/luna-slimes",
        "modmenu.twitter": "https://twitter.com/LunadeModding",
        "modmenu.youtube": "https://www.youtube.com/@LunadeMusic"
      }
    }
  }
}
